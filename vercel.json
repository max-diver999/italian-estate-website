{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/guides/italy-1-euro-homes-program/",
      "destination": "/guides/1-euro-houses-italy/",
      "permanent": true
    },
    {
      "source": "/guides/italy-investor-visa-property/",
      "destination": "/guides/italy-golden-visa/",
      "permanent": true
    },
    {
      "source": "/guides/italy-residency-by-investment-guide/",
      "destination": "/guides/italy-investor-visa-property/",
      "permanent": true
    },
    {
      "source": "/invest-tuscany-property/",
      "destination": "/property-for-sale/tuscany/",
      "permanent": true
    },
    {
      "source": "/invest-puglia-property/",
      "destination": "/property-for-sale/puglia/",
      "permanent": true
    },
    {
      "source": "/invest-sicily-property/",
      "destination": "/property-for-sale/sicily/",
      "permanent": true
    },
    {
      "source": "/invest-liguria-property/",
      "destination": "/property-for-sale/liguria/",
      "permanent": true
    },
    {
      "source": "/invest-milan-property/",
      "destination": "/property-for-sale/lombardy/",
      "permanent": true
    },
    {
      "source": "/invest-rome-property/",
      "destination": "/property-for-sale/lazio/",
      "permanent": true
    },
    {
      "source": "/invest-lake-como-property/",
      "destination": "/property-for-sale/lake-como/",
      "permanent": true
    },
    {
      "source": "/invest-sardinia-property/",
      "destination": "/property-for-sale/sardinia/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.italian-estate.com"
        }
      ],
      "destination": "https://italian-estate.com/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/site-report/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        }
      ]
    },
    {
      "source": "/site-report",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
