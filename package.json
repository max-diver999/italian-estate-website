{
  "name": "italian-estate-website",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/audit-rendered-live.mjs --local --fail",
    "preview": "astro preview",
    "healthcheck": "node scripts/post-deploy-smoke.mjs --http-only",
    "validate:content": "node scripts/qa-audit.mjs",
    "validate:content:changed": "node scripts/qa-audit.mjs --changed",
    "validate:batch": "node scripts/batch-writing-gate.mjs --changed",
    "geo:audit": "node scripts/geo-citability-audit.mjs",
    "audit:content": "node scripts/audit-p0-quality.mjs",
    "audit:templates": "node scripts/audit-templates.mjs",
    "check-heroes": "node scripts/qa-hero-uniqueness.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-links:changed": "node scripts/check-links.mjs --changed",
    "test:auth": "node scripts/test-internal-auth.mjs",
    "geo:upgrade": "node scripts/fix-italy-geo-upgrade.mjs",
    "qa:corpus": "node scripts/qa-corpus-signals.mjs",
    "qa:full": "node scripts/qa-full.mjs",
    "qa:full:quick": "node scripts/qa-full.mjs --quick",
    "corpus:cleanup": "node scripts/corpus-cleanup.mjs",
    "prepush:gate": "node scripts/pre-push-gate.mjs",
    "setup:hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-push && echo 'Git hooks → .githooks (pre-push runs validate:content + build on MDX changes)'",
    "fix:queue": "node scripts/fix-batch-queue.mjs",
    "fix:markdown-glue": "node scripts/fix-markdown-glue-and-slug-links.mjs",
    "fix:card": "node scripts/fix-content-card.mjs",
    "refresh:protected": "node scripts/refresh-protected-slugs.mjs",
    "audit:rendered": "node scripts/audit-rendered-live.mjs",
    "audit:rendered:fail": "node scripts/audit-rendered-live.mjs --fail",
    "fix:leadforms": "node scripts/fix-inline-leadforms.mjs",
    "sync:content-gate": "node scripts/sync-content-gate.mjs",
    "validate:strict": "node scripts/qa-audit.mjs",
    "images:upload": "python3 scripts/upload-mexico-cloudinary.py --collection projects",
    "images:upload:guides": "python3 scripts/upload-mexico-cloudinary.py --collection guides",
    "images:upload:areas": "python3 scripts/upload-mexico-cloudinary.py --collection areas",
    "images:upload:editorial": "python3 scripts/upload-mexico-cloudinary.py --collection editorial",
    "images:upload:content": "python3 scripts/upload-mexico-cloudinary.py --collection all",
    "images:upload:dry": "python3 scripts/upload-mexico-cloudinary.py --collection all --dry-run",
    "images:rollout": "node scripts/rollout-mexico-cloudinary.mjs",
    "images:rollout:content": "node scripts/rollout-mexico-cloudinary-content.mjs",
    "audit:images": "node scripts/audit-all-images.mjs --fail",
    "speed:dims": "node scripts/build-cloudinary-dims.mjs",
    "speed:verify": "node scripts/verify-responsive-images.mjs",
    "upgrade-pack": "node ../more-group-content-os/scripts/upgrade-pack/run.mjs --phase plan",
    "upgrade-pack:continue": "node ../more-group-content-os/scripts/upgrade-pack/run.mjs --phase continue",
    "upgrade-pack:audit": "node ../more-group-content-os/scripts/upgrade-pack/run.mjs --phase 0",
    "upgrade-pack:prepare": "node ../more-group-content-os/scripts/upgrade-pack/run.mjs --phase prepare --apply",
    "upgrade-pack:finalize": "node ../more-group-content-os/scripts/upgrade-pack/run.mjs --phase 9-10",
    "aeo:verify": "node scripts/reference-infra/verify-reference-infra.mjs --config reference-infra.config.json --robots public/robots.txt",
    "aeo:dates": "node scripts/reference-infra/restore-real-updated-dates.mjs --config reference-infra.config.json",
    "aeo:markdown": "node scripts/reference-infra/fix-markdown-structure.mjs --config reference-infra.config.json",
    "aeo:robots": "node scripts/reference-infra/generate-robots.mjs --config reference-infra.config.json",
    "aeo:llms": "node scripts/reference-infra/generate-agent-markdown.mjs --config reference-infra.config.json",
    "geo:score": "node scripts/geo-score.mjs",
    "geo:calibrate": "node scripts/geo-calibrate.mjs",
    "geo:cannibals": "node scripts/geo-cannibals.mjs",
    "geo:signals": "node scripts/geo-signal-lab.mjs",
    "facts:review": "node scripts/facts-review.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.2",
    "@astrojs/sitemap": "3.7.1",
    "@astrojs/vercel": "10.0.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@tailwindcss/vite": "4.2.2",
    "astro": "6.0.8",
    "google-auth-library": "^10.6.2",
    "tailwindcss": "4.2.2",
    "unist-util-visit": "^5.1.0"
  }
}
