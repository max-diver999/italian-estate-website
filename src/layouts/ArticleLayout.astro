---
import BaseLayout from './BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import FaqBlock from '../components/FaqBlock.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import { lcpPreloadFromCloudinary } from '../lib/cloudinary';
import { SITE } from '../data/site';
import { resolveStickyCta } from '../../scripts/lib/italian-estate-cta-router.mjs';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  readingTime?: number;
  heroImage?: string;
  /** Descriptive alt for the hero. Falls back to the article title — the hero
   *  depicts the article's subject, so an empty alt (the previous hardcoded
   *  value on all 252 article pages) drops it from a11y and image search. */
  heroAlt?: string;
  faq?: { question: string; answer: string }[];
  canonical?: string;
  noindex?: boolean;
  hasInlineFaqBlock?: boolean;
  /** Frontmatter `relatedSlugs` — rendered by <RelatedGuides>. */
  relatedSlugs?: string[];
  contextLabel?: string;
  articleSlug?: string;
  articleCollection?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = SITE.editorial,
  readingTime = 8,
  heroImage,
  heroAlt,
  faq = [],
  canonical,
  noindex = false,
  hasInlineFaqBlock = false,
  relatedSlugs = [],
  contextLabel = title,
  articleSlug = '',
  articleCollection = 'guides',
} = Astro.props;

const stickyCta = articleSlug
  ? resolveStickyCta({ collection: articleCollection, slug: articleSlug, title })
  : null;

const dateStr = (updatedDate || pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const pageUrl = canonical || `${SITE.url}${Astro.url.pathname}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
  },
  mainEntityOfPage: pageUrl,
  ...(heroImage ? { image: heroImage } : {}),
};

// Exactly one FAQPage per URL.
//
// When the MDX body renders its own <FaqBlock>, that component emits FAQPage
// JSON-LD built from the questions it actually displays. Emitting a second one
// here from frontmatter `faq` gave every article page two FAQPage entities, and
// on 42 pages the two lists disagreed — markup advertising questions that are
// not visible on the page, which Google's structured-data policy forbids.
//
// The visible block wins: when it is present we stay silent, so the markup can
// never drift from what the reader sees. Frontmatter `faq` still drives the
// schema (and the rendered block below) on pages without an inline FaqBlock.
const faqSchema = !hasInlineFaqBlock && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    ...(pathParts.length > 1 ? [{
      '@type': 'ListItem',
      position: 2,
      name: pathParts[0].charAt(0).toUpperCase() + pathParts[0].slice(1),
      item: `${SITE.url}/${pathParts[0]}/`,
    }] : []),
    {
      '@type': 'ListItem',
      position: pathParts.length > 1 ? 3 : 2,
      name: title,
      item: pageUrl,
    },
  ],
};

const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
const heroPreload = heroImage ? lcpPreloadFromCloudinary(heroImage, 'hero') : null;
---
<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={heroImage}
  type="article"
  {noindex}
  {schemas}
  stickyCta={stickyCta}
  preloadImage={heroPreload?.src}
  preloadImageSrcset={heroPreload?.srcset}
  preloadImageSizes={heroPreload?.sizes}
>
  <article class="site-container py-10 md:py-14">
    <header class="max-w-3xl mb-8">
      <span class="badge-pill mb-4">Research guide</span>
      <h1 class="mb-4 text-3xl md:text-4xl">{title}</h1>
      <p class="text-lg text-[var(--color-muted)] mb-4">{description}</p>
      <p class="text-sm text-[var(--color-muted)]">
        By {author} · Updated {dateStr} · {readingTime} min read
      </p>
    </header>

    {heroImage && (
      <figure class="mb-10 rounded-2xl overflow-hidden border border-[var(--color-border)] max-h-[420px]">
        <ResponsiveImage
          src={heroImage}
          alt={heroAlt || title}
          role="hero"
          class="w-full max-h-[420px] object-cover"
          loading="eager"
          fetchpriority="high"
          width={1200}
          height={420}
        />
      </figure>
    )}

    <div class="prose mx-auto">
      <slot />
    </div>

    {!hasInlineFaqBlock && faq.length > 0 && (
      <div class="max-w-3xl mx-auto mt-10">
        <FaqBlock items={faq} />
      </div>
    )}

    <RelatedGuides slugs={relatedSlugs} currentSlug={articleSlug} />

    <div class="max-w-3xl mx-auto mt-12">
      <LeadForm
        title="Get an Italy property shortlist"
        subtitle="Tell us your budget and region (Tuscany, Lake Como, Puglia, Milan, Sardinia). We reply within one business day with options matched to your goals."
        context={contextLabel}
      />
    </div>

    <aside class="max-w-3xl mx-auto mt-10 surface-card p-5 text-sm text-[var(--color-muted)]">
      <strong>About Italian Estate:</strong> we are an independent research team rather than a developer or listing agent, so our guides are
      written to inform you, not to sell you a property. Market figures and rules move, so we keep this page reviewed and dated, and we work
      alongside licensed Italian agencies and professionals who handle the transaction itself whenever you are ready.
    </aside>
  </article>
</BaseLayout>
