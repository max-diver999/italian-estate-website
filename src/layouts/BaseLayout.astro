---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import PostHog from '../components/PostHog.astro';
import WhatsAppIntentTracker from '../components/WhatsAppIntentTracker.astro';
import StickyMobileLeadBar from '../components/StickyMobileLeadBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CurrencyEngine from '../components/CurrencyEngine.astro';
import { SITE } from '../data/site';

interface StickyCtaProps {
  title: string;
  subtitle: string;
  buttonText: string;
  buttonHref: string;
  ctaId?: string;
}

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: object[];
  stickyCta?: StickyCtaProps | null;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title,
  description = SITE.description,
  canonical,
  ogImage = `${SITE.url}/og-default.png?v=2`,
  type = 'website',
  noindex = false,
  schemas = [],
  stickyCta = null,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

// Canonical always resolves to the apex host, never www or a preview domain.
const canonicalHref = canonical || `${SITE.url}${Astro.url.pathname}`;

// Google truncates title links at roughly 60-62 characters. Frontmatter titles
// here run 36-60 chars, so unconditionally appending " | Italian Estate" (+17)
// pushed 187 pages past the limit and cut the brand — and often the last real
// keyword — out of the SERP snippet entirely.
//
// The brand is now additive, not mandatory: it is appended only when it fits.
// A title that is already long keeps its own words, which are what the click is
// won on. og:title and twitter:title follow the same string for consistency.
const TITLE_MAX = 60;
const BRAND_SUFFIX = ' | Italian Estate';
const fullTitle =
  title.includes('Italian Estate') || title.length + BRAND_SUFFIX.length > TITLE_MAX
    ? title
    : `${title}${BRAND_SUFFIX}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'customer service',
    availableLanguage: ['English', 'Italian'],
  },
  sameAs: [
    SITE.url,
    ...SITE.sameAs,
    ...(SITE.wikidataId ? [`https://www.wikidata.org/wiki/${SITE.wikidataId}`] : []),
  ],
};

const allSchemas = [orgSchema, ...schemas];
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex,nofollow" />
    : <meta name="robots" content="index,follow,max-image-preview:large" />}
  {!noindex && <link rel="canonical" href={canonicalHref} />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta name="twitter:image" content={ogImage} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=3" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <!-- Fonts: self-hosted via @fontsource in global.css (no third-party font requests) -->
  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
  <link rel="dns-prefetch" href="https://res.cloudinary.com" />
  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage}
      fetchpriority="high"
      {...(preloadImageSrcset ? { imagesrcset: preloadImageSrcset, imagesizes: preloadImageSizes } : {})}
    />
  )}
  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  {stickyCta && <StickyMobileLeadBar {...stickyCta} />}
  <WhatsAppFloat />
  <CurrencyEngine />
  <WhatsAppIntentTracker />
  <GoogleAnalytics />
  <PostHog />
</body>
</html>
