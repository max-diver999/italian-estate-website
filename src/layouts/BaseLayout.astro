---
import globalStyles from '../styles/global.css?url';
import dmSans400 from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import PostHog from '../components/PostHog.astro';
import WhatsAppIntentTracker from '../components/WhatsAppIntentTracker.astro';
import StickyMobileLeadBar from '../components/StickyMobileLeadBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CurrencyEngine from '../components/CurrencyEngine.astro';
import { SITE } from '../data/site';

interface StickyCtaProps {
  title: string;
  subtitle: string;
  buttonText: string;
  buttonHref: string;
  ctaId?: string;
}

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: object[];
  stickyCta?: StickyCtaProps | null;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title,
  description = SITE.description,
  canonical,
  ogImage = `${SITE.url}/og-default.png?v=2`,
  type = 'website',
  noindex = false,
  schemas = [],
  stickyCta = null,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

const canonicalHref = canonical || `${SITE.url}${Astro.url.pathname}`;

const TITLE_MAX = 60;
const BRAND_SUFFIX = ' | Italian Estate';
const fullTitle =
  title.includes('Italian Estate') || title.length + BRAND_SUFFIX.length > TITLE_MAX
    ? title
    : `${title}${BRAND_SUFFIX}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'customer service',
    availableLanguage: ['English', 'Italian'],
  },
  sameAs: [
    SITE.url,
    ...SITE.sameAs,
    ...(SITE.wikidataId ? [`https://www.wikidata.org/wiki/${SITE.wikidataId}`] : []),
  ],
};

const allSchemas = [orgSchema, ...schemas];
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#2c6b62" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex,nofollow" />
    : <meta name="robots" content="index,follow,max-image-preview:large" />}
  {!noindex && <link rel="canonical" href={canonicalHref} />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta name="twitter:image" content={ogImage} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=3" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preload" href={dmSans400} as="font" type="font/woff2" crossorigin />

  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
  <link rel="dns-prefetch" href="https://res.cloudinary.com" />

  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage}
      fetchpriority="high"
      {...(preloadImageSrcset ? { imagesrcset: preloadImageSrcset, imagesizes: preloadImageSizes } : {})}
    />
  )}

  <style is:inline>
    :root {
      --color-page: #f7f8f6;
      --color-surface: #ffffff;
      --color-ink: #1f2421;
      --color-muted: #5d645f;
      --color-teal: #2c6b62;
      --color-border: #e6e6e3;
      --color-border-soft: #eeeeec;
      --font-sans: 'DM Sans', system-ui, sans-serif;
    }
    html { -webkit-font-smoothing: antialiased; }
    body {
      margin: 0;
      background: var(--color-page);
      color: var(--color-muted);
      font-family: var(--font-sans);
      line-height: 1.65;
      font-size: 1rem;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }
    body > main { flex: 1 0 auto; }
    h1, h2, h3 {
      font-family: var(--font-sans);
      color: var(--color-ink);
      line-height: 1.25;
      font-weight: 600;
    }
    .hero-visual {
      position: relative;
      overflow: hidden;
      border-radius: 1.25rem;
      border: 1px solid var(--color-border);
    }
    .hero-visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      min-height: 280px;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--color-teal);
      color: #fff;
      font-weight: 600;
      text-decoration: none;
      border-radius: 8px;
    }
  </style>

  <link rel="preload" href={globalStyles} as="style" />
  <link rel="stylesheet" href={globalStyles} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={globalStyles} /></noscript>

  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  {stickyCta && <StickyMobileLeadBar {...stickyCta} />}
  <WhatsAppFloat />
  <CurrencyEngine />
  <WhatsAppIntentTracker />
  <GoogleAnalytics />
  <PostHog />
</body>
</html>
