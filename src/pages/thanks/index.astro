---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

// Rendered per request: as a prerendered page the ?lead=1 branch never existed,
// so neither the confirmation copy nor the generate_lead event ever shipped.
export const prerender = false;

const isLead = Astro.url.searchParams.get('lead') === '1';
---
<BaseLayout
  title="Thank You"
  description="Thank you for contacting Italian Estate."
  noindex={true}
>
  <section class="site-container py-20 max-w-xl text-center">
    <p class="text-4xl mb-4">✓</p>
    <h1 class="mb-4">{isLead ? 'Request received' : 'Thank you'}</h1>
    <p class="text-[var(--color-muted)] mb-8">
      {isLead
        ? 'We received your shortlist request. We reply on WhatsApp or email within one business day.'
        : `Thanks for visiting ${SITE.name}.`}
    </p>
    <a href="/guides/" class="btn-primary px-6 py-3">Browse guides</a>
  </section>
  {/* Two defects lived here. The script called `window.investGulfTrack`, which is
      the Gulf site's tracker and does not exist on this site, so it always fell
      through to `gtag` — and being is:inline it ran at parse time, three seconds
      before GoogleAnalytics.astro defines either. Every conversion was dropped.

      `track` targets this site's tracker and queues until it exists. The pending
      stamp still de-duplicates against a submit that has just been counted, but
      its absence no longer blocks the event: without that, `generate_lead` can
      never appear in GA4 for the first time and cannot be marked a key event. */}
  <script>
    import { track } from '../../lib/track';

    if (new URLSearchParams(window.location.search).get('lead') === '1') {
      let pending: { form_page?: string } | null = null;
      try {
        const raw = sessionStorage.getItem('ie_lead_pending');
        if (raw) pending = JSON.parse(raw);
        sessionStorage.removeItem('ie_lead_pending');
        sessionStorage.removeItem('ie_lead_tracked');
      } catch {
        /* private mode: report once without the handoff */
      }
      const params: Record<string, unknown> = { lead_type: 'shortlist_form', value: 1, currency: 'EUR' };
      if (pending?.form_page) params.form_page = pending.form_page;
      track('generate_lead', params);
    }
  </script>
</BaseLayout>
