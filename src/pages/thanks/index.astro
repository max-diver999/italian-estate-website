---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

const isLead = Astro.url.searchParams.get('lead') === '1';
---
<BaseLayout
  title="Thank You"
  description="Thank you for contacting Italian Estate."
  noindex={true}
>
  <section class="site-container py-20 max-w-xl text-center">
    <p class="text-4xl mb-4">✓</p>
    <h1 class="mb-4">{isLead ? 'Request received' : 'Thank you'}</h1>
    <p class="text-[var(--color-muted)] mb-8">
      {isLead
        ? 'We received your shortlist request. We reply on WhatsApp or email within one business day.'
        : `Thanks for visiting ${SITE.name}.`}
    </p>
    <a href="/guides/" class="btn-primary px-6 py-3">Browse guides</a>
  </section>
  {isLead && (
    <script is:inline>
      (function () {
        var pending = null;
        var storageOk = true;
        try {
          var raw = sessionStorage.getItem('ie_lead_pending');
          if (raw) {
            pending = JSON.parse(raw);
            sessionStorage.removeItem('ie_lead_pending');
          }
          sessionStorage.removeItem('ie_lead_tracked');
        } catch (_) {
          storageOk = false;
        }
        // A reload or a direct visit has no pending submit, so it must not be counted.
        if (!pending && storageOk) return;
        var params = { lead_type: 'shortlist_form', value: 1, currency: 'EUR' };
        if (pending && pending.form_page) params.form_page = pending.form_page;
        if (typeof window.investGulfTrack === 'function') {
          window.investGulfTrack('generate_lead', params);
        } else if (typeof window.gtag === 'function') {
          window.gtag('event', 'generate_lead', params);
        }
      })();
    </script>
  )}
</BaseLayout>
