---
import { SITE } from '../data/site';
import CurrencyToggle from './CurrencyToggle.astro';

const nav = [
  { label: 'Guides', href: '/guides/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Areas', href: '/areas/' },
  { label: 'Compare', href: '/compare/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const browse = [
  { label: 'Guides', href: '/guides/', note: 'Buying, taxes and due diligence' },
  { label: 'Projects', href: '/projects/', note: 'Italian developments and residences' },
  { label: 'Areas', href: '/areas/', note: 'Cities, regions and local markets' },
  { label: 'Compare', href: '/compare/', note: 'Locations and investment strategies' },
  { label: 'Developers', href: '/developers/', note: 'Developer profiles and track records' },
  { label: 'News', href: '/news/', note: 'Dated legal and market updates' },
];

const about = [
  { label: 'About', href: '/about/' },
  { label: 'Methodology', href: '/methodology/' },
  { label: 'Contact', href: '/contact/' },
];
---
<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[rgba(255,255,255,0.9)] backdrop-blur-md">
  <div class="site-container flex items-center justify-between gap-3 py-4">
    <a href="/" class="flex items-center gap-2 no-underline min-w-0">
      <img src="/favicon.svg?v=3" alt="" width="32" height="32" class="rounded-lg" />
      <span class="text-lg font-semibold text-[var(--color-ink)] whitespace-nowrap">{SITE.name}</span>
    </a>
    <nav class="hidden lg:flex items-center gap-5 text-sm font-medium" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} class="text-[var(--color-muted)] hover:text-[var(--color-ink)] no-underline">{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2 shrink-0">
      <CurrencyToggle variant="header" />
      <a href="/get-shortlist/" class="btn-primary mobile-header-cta text-sm px-4 py-2 shrink-0">Free shortlist</a>
      <button
        type="button"
        id="site-nav-toggle"
        class="site-nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-nav-drawer"
      >
        <span class="site-nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div id="site-nav-drawer" class="site-nav-drawer" hidden>
    <div class="site-nav-drawer__panel">
      <a href="/get-shortlist/" class="site-nav-drawer__cta">Get a free shortlist</a>
      <CurrencyToggle variant="drawer" />

      <p class="site-nav-drawer__label">Browse</p>
      <ul class="site-nav-drawer__list">
        {browse.map((item) => (
          <li>
            <a href={item.href}>
              <span class="site-nav-drawer__link">{item.label}</span>
              <span class="site-nav-drawer__note">{item.note}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="site-nav-drawer__label">The site</p>
      <ul class="site-nav-drawer__list site-nav-drawer__list--compact">
        {about.map((item) => (
          <li><a href={item.href}><span class="site-nav-drawer__link">{item.label}</span></a></li>
        ))}
      </ul>
    </div>
  </div>
</header>

<style>
  .site-nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }
  .site-nav-toggle__bars { display: block; width: 18px; }
  .site-nav-toggle__bars span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .site-nav-toggle__bars span + span { margin-top: 4px; }
  .site-nav-toggle[aria-expanded='true'] .site-nav-toggle__bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .site-nav-toggle[aria-expanded='true'] .site-nav-toggle__bars span:nth-child(2) { opacity: 0; }
  .site-nav-toggle[aria-expanded='true'] .site-nav-toggle__bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  .site-nav-drawer {
    position: fixed;
    inset: 77px 0 auto;
    max-height: calc(100dvh - 77px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 0 16px 32px rgba(31, 36, 33, 0.12);
  }
  .site-nav-drawer__panel {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
    padding: 1rem 1.5rem calc(2rem + env(safe-area-inset-bottom, 0px));
  }
  .site-nav-drawer__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    margin-bottom: 1rem;
    border-radius: 10px;
    background: var(--color-teal-dark);
    color: #fff !important;
    font-weight: 700;
    text-decoration: none;
  }
  .site-nav-drawer__label {
    margin: 0 0 0.35rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-nav-drawer__list {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }
  .site-nav-drawer__list li { border-bottom: 1px solid var(--color-border-soft); }
  .site-nav-drawer__list a {
    display: block;
    min-height: 64px;
    padding: 0.65rem 0;
    color: var(--color-ink);
    text-decoration: none;
  }
  .site-nav-drawer__link { display: block; font-weight: 650; }
  .site-nav-drawer__note { display: block; margin-top: 0.1rem; color: var(--color-muted); font-size: 0.8rem; }
  .site-nav-drawer__list--compact a { min-height: 46px; }
  @media (max-width: 767px) {
    .mobile-header-cta { display: none; }
  }
  @media (min-width: 1024px) {
    .site-nav-toggle,
    .site-nav-drawer { display: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav-toggle__bars span { transition: none; }
  }
</style>

<script>
  (function () {
    var toggle = document.getElementById('site-nav-toggle');
    var drawer = document.getElementById('site-nav-drawer');
    if (!toggle || !drawer) return;

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      drawer.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    drawer.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () { setOpen(false); });
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') setOpen(false);
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth >= 1024) setOpen(false);
    }, { passive: true });
  })();
</script>
