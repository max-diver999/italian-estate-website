---
import { getCardImage } from '../lib/cardImage';

interface Props {
  href: string;
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  badges?: string[];
  meta?: string;
  price?: string;
  metaAccent?: boolean;
  placeholder?: string;
}

const {
  href,
  title,
  description = '',
  image,
  imageAlt,
  badges = [],
  meta,
  price,
  metaAccent = false,
  placeholder = 'Photo pending',
} = Astro.props;

const photo = getCardImage(image, 'card');

// Галерейная витрина: метки и мета живут одной приглушённой строкой над заголовком.
// Метка, повторяющая сам заголовок, в плоской строке читается как мусор, её отбрасываем.
const titleLower = title.toLowerCase();
const isTitleEcho = (badge: string) =>
  badge.length >= 12 &&
  titleLower.includes(badge.toLowerCase()) &&
  badge.length / title.length >= 0.5;
const metaLine = [
  ...badges.filter((b) => b && !isTitleEcho(b)).slice(0, 3),
  ...(meta && !metaAccent ? [meta] : []),
]
  .filter(Boolean)
  .join(' · ');
const accentPrice = price ?? (metaAccent ? meta : undefined);
---

<a href={href} class="content-card block no-underline h-full">
  {photo ? (
    <div class="content-card__media">
      <img
        src={photo.src}
        srcset={photo.srcset}
        sizes={photo.sizes}
        alt={imageAlt || title}
        loading="lazy"
        decoding="async"
        width="640"
        height="360"
      />
    </div>
  ) : (
    <div class="content-card__media content-card__media--placeholder" aria-hidden="true">
      <span>{placeholder}</span>
    </div>
  )}
  <div class="content-card__body">
    {metaLine && <span class="content-card__tags">{metaLine}</span>}
    <div class="content-card__head">
      <h3 class="content-card__title">{title}</h3>
      {accentPrice && <span class="content-card__price">{accentPrice}</span>}
    </div>
    {description && <p class="content-card__desc">{description}</p>}
  </div>
</a>
