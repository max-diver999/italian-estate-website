---
/**
 * PostHog , product analytics + selective session replay for lead funnels.
 *
 * Vercel / .env:
 *   PUBLIC_POSTHOG_KEY=phc_...
 *   PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
 */
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY as string | undefined;
const posthogHost = (import.meta.env.PUBLIC_POSTHOG_HOST as string | undefined) || 'https://us.i.posthog.com';
---
{posthogKey && (
  <script define:vars={{ posthogKey, posthogHost }}>
    function scheduleAfterFullLoad(callback, delayMs) {
      const ms = delayMs ?? 3000;
      const run = () => setTimeout(callback, ms);
      if (document.readyState === 'complete') run();
      else window.addEventListener('load', run, { once: true });
    }

    function bootItalianEstatePostHog() {
    !(function (t, e) {
      var o, n, p, r;
      e.__SV ||
        ((window.posthog = e),
        (e._i = []),
        (e.init = function (i, s, a) {
          function g(t, e) {
            var o = e.split('.');
            2 == o.length && ((t = t[o[0]]), (e = o[1])),
              (t[e] = function () {
                t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
              });
          }
          ((p = t.createElement('script')).type = 'text/javascript'),
            (p.crossOrigin = 'anonymous'),
            (p.async = !0),
            (p.src = s.api_host.replace('.i.posthog.com', '-assets.i.posthog.com') + '/static/array.js'),
            (r = t.getElementsByTagName('script')[0]).parentNode.insertBefore(p, r);
          var u = e;
          void 0 !== a ? (u = e[a] = []) : (a = 'posthog');
          u.people = u.people || [];
          u.toString = function (t) {
            var e = 'posthog';
            return 'posthog' !== a && (e += '.' + a), t || (e += ' (stub)'), e;
          };
          u.people.toString = function () {
            return u.toString(1) + '.people (stub)';
          };
          o =
            'init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug'.split(
              ' ',
            );
          for (n = 0; n < o.length; n++) g(u, o[n]);
          e._i.push([i, s, a]);
        }),
        (e.__SV = 1));
    })(document, window.posthog || []);

    function getPageCategory(pathname) {
      const path = pathname.replace(/\/+$/, '') || '/';
      if (path === '/contact' || path.startsWith('/contact/')) return 'contact';
      if (path.startsWith('/guides/')) return 'guide';
      if (path.startsWith('/projects/')) return 'project';
      if (path.startsWith('/compare/')) return 'comparison';
      if (path.startsWith('/areas/')) return 'area';
      if (path.startsWith('/developers/')) return 'developer';
      if (path.startsWith('/news/')) return 'news';
      return 'other';
    }

    function isMoneyPage(category) {
      return category === 'contact' || category === 'guide' || category === 'project';
    }

    function maybeStartReplay(reason) {
      try {
        if (typeof posthog.startSessionRecording === 'function' && !posthog.sessionRecordingStarted()) {
          posthog.startSessionRecording();
          posthog.capture('session_replay_started', { replay_trigger: reason, page_path: window.location.pathname });
        }
      } catch (_) {}
    }

    window.italianEstatePostHog = function (eventName, params = {}) {
      try {
        if (typeof posthog.capture !== 'function') return;
        const pageCategory = getPageCategory(window.location.pathname);
        posthog.capture(eventName, {
          page_location: window.location.href,
          page_path: window.location.pathname,
          page_category: pageCategory,
          is_money_page: isMoneyPage(pageCategory),
          ...params,
        });
        if (['form_start', 'lead_form_visible', 'form_step_2_view', 'cta_click', 'whatsapp_click'].includes(eventName)) {
          maybeStartReplay(eventName);
        }
      } catch (_) {}
    };

    posthog.init(posthogKey, {
      api_host: posthogHost,
      autocapture: true,
      capture_pageview: true,
      capture_pageleave: true,
      disable_session_recording: true,
      session_recording: {
        maskAllInputs: true,
        maskTextSelector: '[data-ph-mask]',
      },
      persistence: 'localStorage+cookie',
      property_denylist: ['$ip'],
    });

    const pageCategory = getPageCategory(window.location.pathname);
    posthog.register({
      site: 'italian-estate.com',
      page_category: pageCategory,
      is_money_page: isMoneyPage(pageCategory),
    });

    if (isMoneyPage(pageCategory)) {
      posthog.capture('money_page_view', {
        page_path: window.location.pathname,
        page_category: pageCategory,
      });
    }

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const action = target?.closest('a[href], button[data-cta]');
      if (!action) return;

      const href = action.getAttribute('href') || '';
      const label = (action.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 120);
      const ctaId = action.getAttribute('data-cta') || action.getAttribute('aria-label') || label || 'unknown';
      const baseParams = {
        cta_id: ctaId,
        link_url: href,
        link_text: label,
      };

      if (/wa\.me|whatsapp/i.test(href) || action.hasAttribute('data-wa-placement')) {
        window.italianEstatePostHog('whatsapp_click', baseParams);
        return;
      }

      if (href.startsWith('tel:') || href.startsWith('mailto:')) {
        window.italianEstatePostHog('contact_click', baseParams);
        return;
      }

      if (href === '#lead-form' || href.endsWith('/contact/') || action.hasAttribute('data-cta')) {
        window.italianEstatePostHog('cta_click', baseParams);
      }
    });

    const observeLeadForms = () => {
      document.querySelectorAll('.lead-form-section, #lead-form').forEach((section) => {
        if (section.dataset.phVisibleTracked === 'true') return;
        section.dataset.phVisibleTracked = 'true';
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              window.italianEstatePostHog('lead_form_visible', {
                form_section_id: section.id || 'unknown',
              });
              observer.disconnect();
            });
          },
          { threshold: 0.35 },
        );
        observer.observe(section);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', observeLeadForms, { once: true });
    } else {
      observeLeadForms();
    }
    }

    scheduleAfterFullLoad(bootItalianEstatePostHog, 3000);
  </script>
)}
