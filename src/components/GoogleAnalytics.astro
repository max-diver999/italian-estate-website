---
/**
 * GA4 — set PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX in Vercel / .env
 * Loads 3s after full page load (LCP-first).
 */
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
---
{measurementId && (
  <script define:vars={{ measurementId }}>
    function scheduleAfterFullLoad(callback, delayMs) {
      const ms = delayMs ?? 3000;
      const run = () => setTimeout(callback, ms);
      if (document.readyState === 'complete') run();
      else window.addEventListener('load', run, { once: true });
    }

    function bootGoogleAnalytics() {
      const loader = document.createElement('script');
      loader.async = true;
      loader.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(loader);

      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = window.gtag || gtag;
      gtag('js', new Date());
      gtag('config', measurementId, {
        send_page_view: true,
        anonymize_ip: true,
      });

      function trackSiteEvent(eventName, params = {}) {
        const payload = {
          page_location: window.location.href,
          page_path: window.location.pathname,
          transport_type: 'beacon',
          ...params,
        };
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, payload);
        }
        window.dataLayer.push({ event: eventName, ...payload });
      }

      window.italianEstateTrack = trackSiteEvent;

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const action = target?.closest('a[href], button[data-cta]');
        if (!action) return;

        const href = action.getAttribute('href') || '';
        const label = (action.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 120);
        const ctaId = action.getAttribute('data-cta') || action.getAttribute('aria-label') || label || 'unknown';
        const baseParams = {
          cta_id: ctaId,
          link_url: href,
          link_text: label,
        };

        if (/wa\.me|whatsapp/i.test(href)) {
          trackSiteEvent('whatsapp_click', baseParams);
          return;
        }

        if (href.startsWith('tel:') || href.startsWith('mailto:')) {
          trackSiteEvent('contact_click', baseParams);
          return;
        }

        if (href === '#lead-form' || href.endsWith('/contact/') || action.hasAttribute('data-cta')) {
          trackSiteEvent('cta_click', baseParams);
        }
      });
    }

    scheduleAfterFullLoad(bootGoogleAnalytics, 3000);
  </script>
)}
