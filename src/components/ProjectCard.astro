---
import ContentCard from './ContentCard.astro';
import { formatAreaLabel, formatEur } from '../lib/cardImage';

interface Props {
  href: string;
  title: string;
  description?: string;
  image?: string;
  area?: string;
  developer?: string;
  propertyType?: string;
  status?: string;
  priceFromEur?: number;
}

const {
  href,
  title,
  description,
  image,
  area,
  developer,
  propertyType,
  status,
  priceFromEur,
} = Astro.props;

const badges = [
  propertyType ? propertyType.replace(/-/g, ' ') : '',
  status === 'off-plan' ? 'Off-plan' : status === 'completed' ? 'Completed' : '',
  formatAreaLabel(area),
].filter(Boolean);

const price = formatEur(priceFromEur);
const priceLabel = price ? `From ${price}` : undefined;
---

<ContentCard
  href={href}
  title={title}
  description={description}
  image={image}
  badges={badges}
  meta={developer}
  price={priceLabel}
  placeholder="Render pending"
/>
